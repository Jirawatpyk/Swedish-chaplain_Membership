#!/usr/bin/env sh
# Pre-push: ONLY the gates CI does not run (D-033, 2026-10-28).
#
# Gate layering — each check runs once, where it pays:
#   - local, on demand: `pnpm check` (lint [cached], typegen, typecheck, the
#     static check:* gates), run once after the last edit;
#   - this hook: the live-Neon integration suites for what the push touches
#     (per-module Spec Coverage Gate + the API-route gate below) — CI's PR run
#     has only the integration SMOKE, so these exist nowhere else before merge;
#   - CI (required on main): lint, typecheck, every static check:* gate, the
#     tests/unit/architecture/ suite, unit + contract, coverage, smoke.
#
# MOVED OUT 2026-10-28 (D-033): the 13 static check:* gates and the
# architecture suite (68–82 s measured) used to run here as well, so every
# push re-ran what `pnpm check` had just run and CI was about to run again.
# All of them are required status checks on main, so nothing merges without
# them; the cost is that a miss now surfaces in CI minutes after the push
# instead of at push time. The user chose that trade-off. Each gate's
# rationale lives in its script under scripts/ and in docs/decisions.md.
#
# MOVED OUT 2026-07-28: tests/contract/ (258 s) — runs in quality-gates.yml;
# run it locally before opening a PR with: pnpm vitest run tests/contract/

# ===========================================================================
# Spec Coverage Gate — per-module integration tests (R10 retrospective HIGH-1)
# ===========================================================================
#
# When the push touches `src/modules/{module}/**` AND a matching
# `tests/integration/{module}/` directory exists, run that module's
# integration suite to catch the regression class that R8/R9/R10
# missed: pre-existing read-time invariant conflicts + writer-path
# misalignments that only surface when both layers run against a
# real DB.
#
# Triggered by: 8+ test failures in QA pass on commit 5ba665bc that
# had been RED on `main` for ~3 weeks (R3 regression class). Pre-push
# integration gate would have caught these on the FIRST commit.
#
# Performance: only runs the modules ACTUALLY touched in the push
# (typically 0–1 modules → 0–8 min). For multi-module pushes the
# tests run sequentially to avoid Neon connection-pool exhaustion.
#
# Emergency override: `SKIP_INTEGRATION_PREPUSH=1 git push` skips the
# gate. Use sparingly — document why in commit message.
#
# Detection logic:
#   1. Compute diff against the upstream/default branch via
#      `git merge-base` + `git diff --name-only` (handles both
#      feature branches and direct main pushes).
#   2. Extract touched `src/modules/{module}` names.
#   3. For each, run `pnpm test:integration tests/integration/{module}/`
#      if the directory exists.
#
# Exits non-zero on any test failure — blocks the push.

if [ -n "$SKIP_INTEGRATION_PREPUSH" ]; then
  echo "[pre-push] SKIP_INTEGRATION_PREPUSH=1 — skipping spec coverage gate (use sparingly)"
else
  # Diff baseline preference (most → least specific):
  #   1. `@{u}` (remote-tracking ref) — what's NOT yet pushed to the
  #      remote tracking branch. For branches that have been pushed
  #      before this is just the NEW commits since the last push;
  #      avoids the "long-running branch with 200+ commits triggers
  #      all-module integration runs" anti-pattern.
  #   2. `HEAD~1` — first push on a never-pushed branch; gate only
  #      checks the most-recent commit. Documented in commit message
  #      that user should split a long-running branch into smaller
  #      PRs to keep pre-push fast.
  #   3. `HEAD` — branch with no parent (edge case; skips gate).
  if git rev-parse --verify '@{u}' >/dev/null 2>&1; then
    BASELINE='@{u}'
  elif git rev-parse --verify 'origin/main' >/dev/null 2>&1     && MERGE_BASE=$(git merge-base origin/main HEAD 2>/dev/null)     && [ -n "$MERGE_BASE" ]; then
    # FIRST push of a branch: gate everything the branch ADDS, not just its
    # last commit.
    #
    # This used to be `HEAD~1`, on the reasoning that a long branch would
    # trigger too many module suites. The cost of that shortcut was measured on
    # 108-contact-recipient-rules: 39 commits that rewrote src/modules/invoicing
    # pushed with the hook printing "no src/modules/* changes in this push", and
    # a broken cron rode along undetected for the whole branch. A gate that
    # inspects one commit of thirty-nine is not gating the push.
    #
    # `SKIP_INTEGRATION_PREPUSH=1` remains the escape hatch for a genuinely
    # oversized first push — but it is now an explicit choice with a rationale
    # in the commit message, not a silent default.
    BASELINE="$MERGE_BASE"
    echo "[pre-push] first push of this branch — gating everything since origin/main ($MERGE_BASE)"
  elif git rev-parse --verify 'HEAD~1' >/dev/null 2>&1; then
    BASELINE='HEAD~1'
    echo "[pre-push] no @{u} and no origin/main — gating only last commit (HEAD~1..HEAD)"
  else
    BASELINE='HEAD'
  fi
  CHANGED_FILES=$(git diff --name-only "$BASELINE" HEAD 2>/dev/null)

  # Extract unique module names from BOTH src/modules/{module} AND
  # tests/integration/{module} prefixes — a test-only change still
  # needs the integration suite run (the regression class includes
  # test-fixture drift like R10.4 UUID-v4 + R10.6 single-event rewrite).
  CHANGED_MODULES=$(echo "$CHANGED_FILES" \
    | grep -oE '^(src/modules|tests/integration)/[^/]+' \
    | sed -E 's#^(src/modules|tests/integration)/##' \
    | sort -u)

  if [ -n "$CHANGED_MODULES" ]; then
    echo "[pre-push] Spec Coverage Gate — modules touched: $(echo $CHANGED_MODULES | tr '\n' ' ')"
    for module in $CHANGED_MODULES; do
      INTEG_DIR="tests/integration/$module"
      if [ -d "$INTEG_DIR" ]; then
        echo "[pre-push] running integration tests for src/modules/$module → $INTEG_DIR"
        # INTEGRATION_FOLDER_RUN: the whole folder runs in ONE long-lived fork
        # (vitest.integration.config.ts `singleFork`) — by the 100th file its
        # client-side timers carry that process's retained state and GC, so a
        # suite that measures per-query latency cannot assert its budget here
        # (tests/helpers/ci-latency.ts); it reports instead
        INTEGRATION_FOLDER_RUN=1 pnpm test:integration "$INTEG_DIR/" || {
          echo "[pre-push] ❌ integration tests failed for module: $module"
          echo "[pre-push]    Fix the failures OR set SKIP_INTEGRATION_PREPUSH=1 to push anyway"
          echo "[pre-push]    (document the skip rationale in commit message)"
          exit 1
        }
      else
        echo "[pre-push] no integration suite for src/modules/$module — skipping"
      fi
    done
  else
    echo "[pre-push] no src/modules/* changes in this push — skipping spec coverage gate"
  fi

  # --- API routes + crons -------------------------------------------------
  #
  # `src/app/api/**` mapped to NO module above, so a route or cron change ran
  # no integration suite at all. That is how 108 shipped a broken
  # void-pdf-reconcile cron: the suite that catches it passes on main, failed on
  # the branch, and nothing ran it — the per-module gate keys on
  # `src/modules/<m>/**` and CI runs only `integration-smoke.yml`.
  #
  # The mapping is EXACT, not a name heuristic: integration tests import a route
  # by its `@/app/api/.../route` path, so we grep for that literal. A heuristic
  # on the last path segment was tried and rejected — `[id]` is a glob character
  # class (it matched `dos-rate-limit.test.ts`) and `cancel` matched an
  # unrelated events suite. Running the WRONG suite is worse than running none.
  #
  # Self-maintaining: write a test that imports the route and it is covered.
  CHANGED_ROUTES=$(echo "$CHANGED_FILES" | grep -E '^src/app/api/.*/route\.ts$' || true)
  if [ -n "$CHANGED_ROUTES" ]; then
    ROUTE_TESTS=''
    for route in $CHANGED_ROUTES; do
      import_path="@/$(echo "$route" | sed -E 's#^src/(.*)[.]ts$#\1#')"
      hits=$(grep -rlF "$import_path" tests/integration/ 2>/dev/null || true)
      if [ -n "$hits" ]; then
        ROUTE_TESTS="$ROUTE_TESTS $hits"
      else
        echo "[pre-push] no integration test imports $route — skipping"
      fi
    done
    ROUTE_TESTS=$(echo "$ROUTE_TESTS" | tr ' ' '
' | grep -v '^$' | sort -u | tr '
' ' ')
    if [ -n "$ROUTE_TESTS" ]; then
      echo "[pre-push] API route gate — running:$ROUTE_TESTS"
      # shellcheck disable=SC2086
      pnpm test:integration $ROUTE_TESTS || {
        echo "[pre-push] ❌ integration tests failed for a changed API route"
        echo "[pre-push]    Fix the failures OR set SKIP_INTEGRATION_PREPUSH=1 to push anyway"
        exit 1
      }
    fi
  fi
fi
