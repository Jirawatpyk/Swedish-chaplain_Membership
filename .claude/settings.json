{
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "neon@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "atomic-agents@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Bash(pnpm format:*)",
      "Bash(prettier --write:*)",
      "Bash(npx prettier --write:*)",
      "Bash(pnpm exec prettier --write:*)",
      "Bash(pnpm db:generate:*)",
      "Bash(pnpm db:push:*)",
      "Bash(pnpm db:migrate:prod:*)",
      "Bash(pnpm seed:system-actors:prod:*)",
      "Bash(pnpm run format:*)",
      "PowerShell(pnpm format:*)",
      "PowerShell(prettier --write:*)",
      "PowerShell(npx prettier --write:*)",
      "PowerShell(pnpm exec prettier --write:*)",
      "PowerShell(pnpm db:generate:*)",
      "PowerShell(pnpm db:push:*)",
      "PowerShell(pnpm db:migrate:prod:*)",
      "PowerShell(pnpm seed:system-actors:prod:*)",
      "PowerShell(pnpm run format:*)",
      "Read(.env*)",
      "Read(!.env.example)",
      "Read(docs/*.xlsx)",
      "Read(docs/*.xlsm)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
