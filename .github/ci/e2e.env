# CI overrides for a PRODUCTION boot (`next build` + `next start`) in the
# e2e-critical workflow (spec 123 US2). The workflow appends every KEY=value
# line below to $GITHUB_ENV after the seed and BEFORE `next build`; process
# env beats `.env.local`, which `.github/actions/ci-neon-env` copies from
# `.env.example`.
#
# NO SECRETS. Every value is synthetic and public. The CI Blob and Upstash
# tokens come from repository secrets in the workflow, never from here.
# One KEY=value per line, no quotes: $GITHUB_ENV keeps quotes literally.
# `tests/unit/architecture/e2e-ci-workflows.test.ts` guards this file.

# Playwright attaches to the started server (playwright.attach.config.ts).
E2E_BASE_URL=http://localhost:3100
APP_BASE_URL=http://localhost:3100
# Without this the proxy's CSRF Origin check rejects every POST in production.
APP_ALLOWED_ORIGINS=http://localhost:3100

# F6 and F7 are on, as in production (#592). env.ts refuses F6 in production
# without ZAPIER_DPA_EXECUTED, and F7 without a privacy inbox. Both values
# below are synthetic: the CI Resend keys are placeholders, so nothing is sent,
# and `.internal` is an unrouted domain (the IANA test TLDs are refused).
FEATURE_F6_EVENTCREATE=true
ZAPIER_DPA_EXECUTED=true
FEATURE_F7_BROADCASTS=true
TENANT_PRIVACY_CONTACT_EMAIL=privacy@ci.chamber-os.internal
# E-Blast member approval (F119), on in production as well.
FEATURE_EBLAST_MEMBER_APPROVAL=true
# F7.1a sub-features, all on in production. Without US2 (and its parent) the
# image-allowlist settings page is a 404, which admin-journey's F7 step reads.
FEATURE_F71A_BROADCAST_ADVANCED=true
FEATURE_F71A_US1_PAGINATION=true
FEATURE_F71A_US2_IMAGES=true
FEATURE_F71A_US7_TEMPLATES=true
FEATURE_F5_ONLINE_PAYMENT=true
# The portal-invoice fixtures are seeded as 088 bills; the app must read them the same way.
FEATURE_088_TAX_AT_PAYMENT=true
FEATURE_F8_RENEWALS=true
# F9 also needs BLOB_PRIVATE_READ_WRITE_TOKEN (a CI secret, distinct from the public one).
FEATURE_F9_DASHBOARD=true
# F114 member-change approval, on in production. The tenant half
# (tenant_member_settings.member_change_approval_enabled) stays off unless a
# spec turns it on, so every other spec keeps the immediate path.
FEATURE_MEMBER_CHANGE_APPROVAL=true
# renewal-pipeline-dashboard AS1 wall-clock bound: a US runner reaches the
# Singapore database across regions (5.7 s measured against the local 5 s).
E2E_RENEWALS_AS1_BUDGET_MS=15000
# Synthetic, CI-only; distinct from every other signing secret in .env.example.
EXPORT_DOWNLOAD_TOKEN_SECRET=synthetic-ci-e2e-export-download-token-not-a-real-secret
